{
  "expo": {
    "name": "Payment Transfer App",
    "slug": "payment-transfer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "payment-transfer-app",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.junwei99.payment-transfer-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2efe7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Payment Transfer App to use Face ID to approve your transfer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
